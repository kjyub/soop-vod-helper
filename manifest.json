{
    "manifest_version": 3,
    "name": "찬밥그릇",
    "description": "Soop VOD 편하게 보기",
    "version": "1.01",
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "128": "icon.png"
    },
    "action": {
      "default_popup": "popups/popup.html",
      "default_icon": "icon.png"
    },
    "host_permissions": [
      "https://vod.sooplive.co.kr/player/*"
    ],
    "content_scripts": [
      {
        "matches": ["https://vod.sooplive.co.kr/player/*"],
        "js": [
          "scripts/observer.js", 
          "scripts/gtl/index.js", 
          "scripts/gtl/comment.js", 
          "scripts/gtl/scroll.js",
          "scripts/player/index.js"
        ],
        "run_at": "document_idle",
        "css": [
          "styles/gtlStyle.css",
          "styles/playerStyle.css"
        ]
      }
    ]
}